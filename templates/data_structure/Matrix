template<typename T>
struct Matrix {
  int n, m;
  std::vector<std::vector<T>> a;

  // 默认构造函数：0×0 空矩阵
  Matrix() : n(0), m(0) {}

  // 参数化构造函数：n 行 m 列，元素初始化为 T()
  Matrix(int n, int m) : n(n), m(m), a(n, std::vector<T>(m, T())) {
    assert(n > 0 && m > 0);
  }

  // 列表初始化：支持 Matrix<int> m = {{1,2},{3,4}};
  Matrix(std::initializer_list<std::initializer_list<T>> init)
    : n(static_cast<int>(init.size())),
      m(n > 0 ? static_cast<int>(init.begin()->size()) : 0),
      a(init.begin(), init.end()) {
    for (const auto& row : init)
      assert(static_cast<int>(row.size()) == m);
  }

  void resize(int new_n, int new_m) {
    assert(new_n > 0 && new_m > 0);
    n = new_n;
    m = new_m;
    a.assign(n, std::vector<T>(m, T()));
  }

  std::tuple<int, int> size() const {
    return {n, m};
  }

  T& operator()(int i, int j) {
    return a[i][j];
  }

  const T& operator()(int i, int j) const {
    return a[i][j];
  }

  // 二元加法
  Matrix operator+(const Matrix& b) const {
    assert(n == b.n && m == b.m);
    Matrix res(n, m);
    for (int i = 0; i < n; ++i)
      for (int j = 0; j < m; ++j)
        res(i, j) = a[i][j] + b(i, j);
    return res;
  }

  // 二元减法
  Matrix operator-(const Matrix& b) const {
    assert(n == b.n && m == b.m);
    Matrix res(n, m);
    for (int i = 0; i < n; ++i)
      for (int j = 0; j < m; ++j)
        res(i, j) = a[i][j] - b(i, j);
    return res;
  }

  // 一元正号：所有元素取绝对值
  Matrix operator+() const {
    Matrix res(n, m);
    for (int i = 0; i < n; ++i)
      for (int j = 0; j < m; ++j)
        res(i, j) = std::abs(a[i][j]);
    return res;
  }

  // 一元负号：所有元素取相反数
  Matrix operator-() const {
    Matrix res(n, m);
    for (int i = 0; i < n; ++i)
      for (int j = 0; j < m; ++j)
        res(i, j) = -a[i][j];
    return res;
  }

  // 矩阵乘法
  Matrix operator*(const Matrix& b) const {
    assert(m == b.n);
    Matrix res(n, b.m);
    for (int i = 0; i < n; ++i)
      for (int k = 0; k < m; ++k)
        for (int j = 0; j < b.m; ++j)
          res(i, j) += a[i][k] * b(k, j);
    return res;
  }

  // add / sub / mul 复用对应运算符
  Matrix add(const Matrix& b) const {
    return *this + b;
  }
  Matrix sub(const Matrix& b) const {
    return *this - b;
  }
  Matrix mul(const Matrix& b) const {
    return *this * b;
  }

  // 快速幂 ^
  template<typename U>
  Matrix operator^(U b) const {
    assert(n == m);
    Matrix res(n, n);
    for (int i = 0; i < n; ++i)
      res(i, i) = T(1);
    Matrix base = *this;
    while (b > U(0)) {
      if (b % U(2) == U(1))
        res = res * base;
      base = base * base;
      b /= U(2);
    }
    return res;
  }

  template<typename U>
  Matrix power(U b) const {
    return *this ^ b;
  }
};