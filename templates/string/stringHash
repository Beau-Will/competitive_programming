struct StringHash {
  using u64 = unsigned long long;

  u64 base;
  std::vector<u64> h;
  std::vector<u64> p;
  std::size_t n;

  // 构造函数，自动调用 work() 预处理
  // baseVal 默认值为 131，也可指定为 13331
  explicit StringHash(const std::string& s, u64 baseVal = 131)
    : base(baseVal) {
    work(s);
  }

  // 对字符串 s 进行哈希预处理
  // 内部会将 s 转换成 1‑based 索引，h 和 p 大小调整为 n+1
  void work(const std::string& s) {
    n = s.size();
    std::string padded = " " + s;
    h.assign(n + 1, 0);
    p.assign(n + 1, 0);
    p[0] = 1;
    for (std::size_t i = 1; i <= n; ++i) {
      p[i] = p[i - 1] * base;
      h[i] = h[i - 1] * base + static_cast<u64>(padded[i]);
    }
  }

  // 查询左闭右闭区间 [l, r] 的哈希值，l, r 从 1 开始
  u64 query(std::size_t l, std::size_t r) const {
    assert(1 <= l && l <= r && r <= n);
    return h[r] - h[l - 1] * p[r - l + 1];
  }

  // 返回字符串长度（不包含占位符）
  std::size_t size() const noexcept {
    return n;
  }
};