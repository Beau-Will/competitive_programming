int manacher(const std::string& s){
  std::string t;
  
  t.push_back('^');
  t.push_back('.');
  for(const auto& si : s){
    t.push_back(si);
    t.push_back('.');
  }
  t.push_back('$');

  int mid, mr = 0;
  std::vector<int> p(t.size());
  for(int i = 1; i < t.size(); i++){
    if(i < mr){
      p[i] = std::min(p[2 * mid - i], mr - i);
    }else{
      p[i] = 1;
    }

    while(t[i - p[i]] == t[i + p[i]]){
      p[i]++;
    }

    if(i + p[i] > mr){
      mr = i + p[i];
      mid = i;
    }
  }

  return *std::max_element(p.begin(), p.end()) - 1;
}